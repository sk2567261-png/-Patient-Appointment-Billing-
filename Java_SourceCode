import java.util.*; class Patient {     int id;     String name,       Patient(int id, String name, String phone) {         this.id = id;         this.name = name;         this.phone = phone;     } } class Doctor {     int id;     String name, specialization;     double fee;     Doctor(int id, String name, String specialization, double fee) {         this.id = id;         this.name = name;         this.specialization = specialization;         this.fee = fee;     } } class Appointment {     int id;     Patient patient;     Doctor doctor;  String date, time, status;     Appointment(int id, Patient patient, Doctor doctor,                 String date, String time) {         this.id = id;         this.patient = patient;         this.doctor = doctor;         this.date = date;         this.time = time;         this.status = "Scheduled";     } } class Prescription {     ArrayList<String> items = new ArrayList<>();     ArrayList<Double> prices = new ArrayList<>();      void addItem(String name, double price) {         items.add(name);         prices.add(price);     }     double getTotal() {         double total = 0;         for (double price : prices)             total += price;         return total;     } } class Consultation {  int id;     Appointment appointment;     Patient patient;     Doctor doctor;     String diagnosis;     Prescription prescription;      Consultation(int id, Appointment appointment, String diagnosis,                  Prescription prescription) {         this.id = id;         this.appointment = appointment;         this.patient = appointment.patient;         this.doctor = appointment.doctor;         this.diagnosis = diagnosis;         this.prescription = prescription;     } } class Invoice {     int id;     Consultation consultation;     double consultationFee, medicineCost, tax, total, paid;     boolean closed = false;     Invoice(int id, Consultation consultation) {         this.id = id;         this.consultation = consultation;         consultationFee = consultation.doctor.fee;         medicineCost = consultation.prescription.getTotal();  tax = (consultationFee + medicineCost) * 0.05;         total = consultationFee + medicineCost + tax;         paid = 0;     }     double getDue() {         return total - paid;     } }  class Payment {     int id;     Invoice invoice;     double amount;     String method;     Payment(int id, Invoice invoice, double amount, String method) {         this.id = id;         this.invoice = invoice;         this.amount = amount;         this.method = method;     } } public class PatientAppointmentBilling {     static Scanner sc = new Scanner(System.in);     static ArrayList<Patient> patients = new ArrayList<>();     static ArrayList<Doctor> doctors = new ArrayList<>();     static ArrayList<Appointment> appointments = new ArrayList<>();     static ArrayList<Consultation> consultations = new ArrayList<>();  static ArrayList<Invoice> invoices = new ArrayList<>();     static ArrayList<Payment> payments = new ArrayList<>();     static int patientId = 1, doctorId = 1, appointmentId = 1;     static int consultationId = 1, invoiceId = 1, paymentId = 1;     static Patient findPatient(int id) {         for (Patient p : patients)             if (p.id == id) return p;         return null;     }      static Doctor findDoctor(int id) {         for (Doctor d : doctors)             if (d.id == id) return d;         return null;     }     static Appointment findAppointment(int id) {         for (Appointment a : appointments)             if (a.id == id) return a;         return null;     }     static Consultation findConsultation(int id) {         for (Consultation c : consultations)             if (c.id == id) return c;         return null;     }     static Invoice findInvoice(int id) {         for (Invoice i : invoices)  if (i.id == id) return i;         return null;     }     static void addPatient() {         System.out.print("Enter patient name: ");         String name = sc.nextLine();         System.out.print("Enter phone number: ");         String phone = sc.nextLine();         patients.add(new Patient(patientId++, name, phone));         System.out.println("Patient added successfully.");     }     static void addDoctor() {         System.out.print("Enter doctor name: ");         String name = sc.nextLine();         System.out.print("Enter specialization: ");         String specialization = sc.nextLine();         System.out.print("Enter consultation fee: ");         double fee = Double.parseDouble(sc.nextLine());         if (fee < 0) {             System.out.println("Fee cannot be negative.");             return;         }         doctors.add(new Doctor(doctorId++, name, specialization, fee));         System.out.println("Doctor added successfully.");     }     static void scheduleAppointment() {         if (patients.isEmpty() || doctors.isEmpty()) { System.out.println("Add a patient and doctor first.");             return;         }         System.out.println("Patients:");         for (Patient p : patients)             System.out.println(p.id + ". " + p.name);         System.out.print("Enter patient ID: ");         Patient p = findPatient(Integer.parseInt(sc.nextLine()));         System.out.println("Doctors:");         for (Doctor d : doctors)             System.out.println(d.id + ". " + d.name +                     " (" + d.specialization + ")");         System.out.print("Enter doctor ID: ");         Doctor d = findDoctor(Integer.parseInt(sc.nextLine()));         if (p == null || d == null) {             System.out.println("Invalid patient or doctor ID.");             return;         }         System.out.print("Enter date (YYYY-MM-DD): ");         String date = sc.nextLine();         System.out.print("Enter time (HH:MM): ");         String time = sc.nextLine();         for (Appointment a : appointments) {             if (a.doctor.id == d.id &&                 a.date.equals(date) &&                 a.time.equals(time) &&                 !a.status.equals("Cancelled")) {    System.out.println("Slot unavailable. Choose another time.");                 return;             }         }         Appointment a = new Appointment(                 appointmentId++, p, d, date, time);         appointments.add(a);         System.out.println("\n--- APPOINTMENT CONFIRMATION ---");         System.out.println("Appointment ID: " + a.id);         System.out.println("Patient: " + p.name);         System.out.println("Doctor: " + d.name);         System.out.println("Date: " + date);         System.out.println("Time: " + time);         System.out.println("Status: " + a.status);     }     static void completeAppointment() {         System.out.print("Enter appointment ID: ");         Appointment a = findAppointment(                 Integer.parseInt(sc.nextLine()));         if (a == null) {             System.out.println("Appointment not found.");             return;         }         if (!a.status.equals("Scheduled")) {             System.out.println("Appointment cannot be completed.");             return;         }   a.status = "Completed";         System.out.println("Appointment marked as completed.");     }     static void recordConsultation() {         System.out.print("Enter completed appointment ID: ");         Appointment a = findAppointment(                 Integer.parseInt(sc.nextLine()));          if (a == null || !a.status.equals("Completed")) {             System.out.println("Consultation requires a completed appointment.");             return;         }         for (Consultation c : consultations) {             if (c.appointment.id == a.id) {                 System.out.println("Consultation already recorded.");                 return;             }         }          System.out.print("Enter diagnosis: ");         String diagnosis = sc.nextLine();         Prescription prescription = new Prescription();         System.out.print("Number of prescribed items: ");         int n = Integer.parseInt(sc.nextLine());         for (int i = 0; i < n; i++) {             System.out.print("Enter item name: ");             String name = sc.nextLine();  System.out.print("Enter item price: ");             double price = Double.parseDouble(sc.nextLine());             if (price < 0) {                 System.out.println("Invalid price. Enter again.");                 i--;                 continue;             }             prescription.addItem(name, price);         }         Consultation c = new Consultation(                 consultationId++, a, diagnosis, prescription);         consultations.add(c);         System.out.println("\n--- CONSULTATION SUMMARY ---");         System.out.println("Consultation ID: " + c.id);         System.out.println("Patient: " + c.patient.name);         System.out.println("Doctor: " + c.doctor.name);         System.out.println("Diagnosis: " + c.diagnosis);         System.out.println("Prescribed items: " +                 c.prescription.items);     }     static void generateInvoice() {         System.out.print("Enter consultation ID: ");         Consultation c = findConsultation(                 Integer.parseInt(sc.nextLine()));         if (c == null) {             System.out.println("Consultation not found.");             return; }         for (Invoice i : invoices) {             if (i.consultation.id == c.id) {                 System.out.println("Invoice already exists. ID: " + i.id);                 return;             }         }         Invoice i = new Invoice(invoiceId++, c);         invoices.add(i);         System.out.println("\n--- INVOICE ---");         System.out.println("Invoice ID: " + i.id);         System.out.println("Patient: " + c.patient.name);         System.out.printf("Consultation fee: Rs. %.2f%n",                 i.consultationFee);         System.out.printf("Prescribed items: Rs. %.2f%n",                 i.medicineCost);         System.out.printf("Tax (5%%): Rs. %.2f%n", i.tax);         System.out.printf("Total amount: Rs. %.2f%n", i.total);         System.out.printf("Outstanding due: Rs. %.2f%n", i.getDue());     }     static void recordPayment() {         System.out.print("Enter invoice ID: ");         Invoice i = findInvoice(Integer.parseInt(sc.nextLine()));         if (i == null) {             System.out.println("Invoice not found.");             return;         }    if (i.closed) {             System.out.println("Invoice is already closed.");             return;         }         System.out.printf("Outstanding amount: Rs. %.2f%n", i.getDue());         System.out.print("Enter payment amount: ");         double amount = Double.parseDouble(sc.nextLine());         if (amount <= 0 || amount > i.getDue() + 0.001) {             System.out.println("Invalid payment amount.");             return;         }         System.out.print("Payment method (Cash/UPI/Card): ");         String method = sc.nextLine();         Payment p = new Payment(paymentId++, i, amount, method);         payments.add(p);         i.paid += amount;         if (i.getDue() < 0.001) {             i.paid = i.total;             i.closed = true;         }         System.out.println("\n--- PAYMENT RECEIPT ---");         System.out.println("Payment ID: " + p.id);         System.out.println("Invoice ID: " + i.id);         System.out.println("Patient: " + i.consultation.patient.name);         System.out.printf("Amount paid: Rs. %.2f%n", amount);         System.out.println("Method: " + method);         System.out.printf("Remaining due: Rs. %.2f%n", i.getDue());   System.out.println("Invoice status: " +                 (i.closed ? "Closed" : "Outstanding"));     }     static void listAppointments() {         if (appointments.isEmpty()) {             System.out.println("No appointments found.");             return;         }         System.out.println("\n--- APPOINTMENT LIST ---");         for (Appointment a : appointments) {             System.out.println("ID: " + a.id +                     " | Patient: " + a.patient.name +                     " | Doctor: " + a.doctor.name +                     " | Date: " + a.date +                     " | Time: " + a.time +                     " | Status: " + a.status);         }     }     static void outstandingDues() {         boolean found = false;         double totalDue = 0;         System.out.println("\n--- OUTSTANDING DUES REPORT ---");         for (Invoice i : invoices) {             if (!i.closed) {                 System.out.println("Invoice ID: " + i.id +                         " | Patient: " + i.consultation.patient.name +                         " | Due: Rs. " +   String.format("%.2f", i.getDue()));                 totalDue += i.getDue();                 found = true;             }         }         if (!found)             System.out.println("No outstanding dues.");         System.out.printf("Total outstanding: Rs. %.2f%n", totalDue);     }     public static void main(String[] args) {         while (true) {             System.out.println("\n===== PATIENT APPOINTMENT & BILLING =====");             System.out.println("1. Add Patient");             System.out.println("2. Add Doctor");             System.out.println("3. Schedule Appointment");             System.out.println("4. Record Consultation");             System.out.println("5. Generate Invoice");             System.out.println("6. Record Payment");             System.out.println("7. List Appointments");             System.out.println("8. Complete Appointment");             System.out.println("9. Outstanding Dues Report");             System.out.println("10. Exit");             System.out.print("Enter your choice: ");             try {                 int choice = Integer.parseInt(sc.nextLine());                 switch (choice) {                     case 1:  addPatient();                         break;                     case 2:                         addDoctor();                         break;                     case 3:                         scheduleAppointment();                         break;                     case 4:                         recordConsultation();                         break;                     case 5:                         generateInvoice();                         break;                     case 6:                         recordPayment();                         break;                     case 7:                         listAppointments();                         break;                     case 8:                         completeAppointment();                         break;                     case 9:                         outstandingDues();                         break;                     case 10:   System.out.println("Thank you!");                         sc.close();                         return;                     default:                         System.out.println("Invalid choice. Try again.");                 }             } catch (NumberFormatException e) {                 System.out.println("Please enter a valid number.");             }         }     } }   
